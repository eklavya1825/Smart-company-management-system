# Server port
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/scms
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/scms
MONGO_URI=mongodb://127.0.0.1:27017/scms

# JWT secret - change this to a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
